{
  "name": "moneo",
  "private": true,
  "engines": {
    "node": ">=22 <23"
  },
  "packageManager": "npm@10.9.8",
  "scripts": {
    "build:artifact-proof": "vite build --configLoader runner --config proof/artifact/vite.config.ts",
    "test:artifact": "npm run build:artifact-proof && playwright test --config proof/artifact/playwright.config.ts",
    "test:artifact:install": "playwright install chromium firefox webkit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run test/harness.test.ts",
    "test:import": "vitest run test/import.test.ts",
    "test:identity": "vitest run test/identity.test.ts",
    "test:identity:docker": "vitest run test/identity-docker-live.test.ts",
    "test:durable": "vitest run test/durable.test.ts",
    "probe:identity": "vitest run test/identity-live.test.ts",
    "test:failure": "vitest run checks/deliberate-failure.test.ts",
    "test:web": "vitest run test/web-health.test.ts",
    "test:auth": "vitest run test/auth.test.ts",
    "test:db": "vitest run test/db-migrate.test.ts",
    "test:tenancy": "vitest run test/tenancy.test.ts",
    "test:commands": "vitest run test/commands.test.ts",
    "test:money": "vitest run test/money.test.ts",
    "test:policy": "vitest run test/ai-policy.test.ts",
    "test:ui": "vitest run test/ui-shell.test.ts",
    "test:auth:live": "vitest run test/auth-keycloak-live.test.ts",
    "build:web": "tsc -p apps/web/tsconfig.json",
    "start:web": "node apps/web/dist/main.js",
    "staging:smoke": "node scripts/staging-smoke.mjs",
    "check": "npm run typecheck && npm test && npm run test:web"
  },
  "dependencies": {
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@playwright/test": "1.62.0",
    "@types/node": "22.20.3",
    "@types/pg": "8.23.1",
    "bullmq": "6.3.6",
    "css-tree": "3.2.1",
    "fflate": "0.8.3",
    "ioredis": "5.11.1",
    "quickjs-emscripten": "0.32.0",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
