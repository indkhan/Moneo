{
  "name": "moneo",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "install:all": "pnpm install",
    "dev": "pnpm --parallel --filter @moneo/web --filter @moneo/worker dev",
    "dev:web": "pnpm --filter @moneo/web dev",
    "dev:worker": "pnpm --filter @moneo/worker dev",
    "dev:infra:up": "docker compose up -d postgres redis minio",
    "dev:infra:down": "docker compose down",
    "dev:reset": "docker compose down -v",
    "db:generate": "pnpm --filter @moneo/db generate",
    "db:migrate": "pnpm --filter @moneo/db migrate",
    "db:seed": "pnpm --filter @moneo/db seed",
    "build": "pnpm --recursive build",
    "build:web": "pnpm --filter @moneo/web build",
    "build:worker": "pnpm --filter @moneo/worker build",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "typecheck": "tsc --build tsconfig.json",
    "test": "pnpm --recursive test",
    "test:unit": "pnpm --recursive test:unit"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@types/node": "^22.7.4",
    "eslint": "^9.14.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.13.0"
  }
}
