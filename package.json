{
  "name": "moneo",
  "private": true,
  "engines": {
    "node": ">=22 <23"
  },
  "packageManager": "npm@10.9.8",
  "scripts": {
    "build:artifact-proof": "vite build --configLoader runner --config proof/artifact/vite.config.ts",
    "test:artifact": "npm run build:artifact-proof && playwright test --config proof/artifact/playwright.config.ts",
    "test:artifact:install": "playwright install chromium firefox webkit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run test/harness.test.ts",
    "test:import": "vitest run test/import.test.ts",
    "test:identity": "vitest run test/identity.test.ts",
    "test:identity:docker": "vitest run test/identity-docker-live.test.ts",
    "test:durable": "vitest run test/durable.test.ts",
    "probe:identity": "vitest run test/identity-live.test.ts",
    "test:failure": "vitest run checks/deliberate-failure.test.ts",
    "test:web": "vitest run test/web-health.test.ts",
    "test:auth": "vitest run test/auth.test.ts",
    "test:db": "vitest run test/db-migrate.test.ts",
    "test:tenancy": "vitest run test/tenancy.test.ts",
    "test:commands": "vitest run test/commands.test.ts",
    "test:money": "vitest run test/money.test.ts",
    "test:policy": "vitest run test/ai-policy.test.ts",
    "test:ai-dispatch": "vitest run test/ai-dispatch.test.ts",
    "test:chat": "vitest run test/chat.test.ts",
    "test:ai-tools": "vitest run test/ai-tools.test.ts",
    "test:chat-ui": "vitest run test/chat-ui.test.ts",
    "test:ai-action": "vitest run test/ai-action.test.ts",
    "test:ai-eval": "vitest run test/ai-eval.test.ts",
    "test:ai-settings": "vitest run test/chat-ui.test.ts -t \"included-AI settings\"",
    "probe:ai-e04:nemotron-free": "node --env-file=.env scripts/probe-ai-e04.mjs",
    "test:ui": "vitest run test/ui-shell.test.ts",
    "test:http": "vitest run test/http-body.test.ts",
    "test:w1": "vitest run test/w1-exit.test.ts",
    "test:jobs": "vitest run test/jobs.test.ts",
    "test:job-recovery": "vitest run test/job-recovery.test.ts",
    "test:upload": "vitest run test/upload.test.ts",
    "test:mapping": "vitest run test/mapping.test.ts",
    "test:import-e2e": "vitest run test/import-e2e.test.ts",
    "test:export": "vitest run test/export.test.ts",
    "test:deletion": "vitest run test/deletion.test.ts",
    "test:retention": "vitest run test/retention.test.ts",
    "test:restore": "vitest run test/restore.test.ts",
    "test:accounts": "vitest run test/accounts.test.ts",
    "test:calculations": "vitest run test/calculations.test.ts",
    "test:fx": "vitest run test/fx.test.ts",
    "test:calc-evidence": "vitest run test/calc-evidence.test.ts",
    "test:categories": "vitest run test/categories.test.ts",
    "test:transactions-table": "vitest run test/transactions-table.test.ts",
    "test:recurring": "vitest run test/recurring.test.ts",
    "test:projection-inputs": "vitest run test/projection-inputs.test.ts",
    "test:goals": "vitest run test/goals.test.ts",
    "test:projections": "vitest run test/projections.test.ts",
    "test:scenarios": "vitest run test/scenarios.test.ts",
    "test:forecast-tools": "vitest run test/forecast-tools.test.ts",
    "test:projection-sdk": "vitest run test/projection-sdk.test.ts",
    "test:e06-exit": "vitest run test/e06-exit.test.ts",
    "test:deep-analysis": "vitest run test/deep-analysis.test.ts",
    "test:home": "vitest run test/home.test.ts",
    "test:home-layout": "vitest run test/home-layout.test.ts",
    "test:navigation-jobs": "vitest run test/navigation-jobs.test.ts",
    "test:e07-exit": "vitest run test/e07-exit.test.ts",
    "test:e03-exit": "vitest run test/e03-exit.test.ts",
    "test:artifact-build": "vitest run test/artifact-build.test.ts",
    "test:artifact-runtime": "playwright test --config test/artifact-runtime.config.mjs",
    "test:artifact-ui": "vitest run test/artifact-ui.test.ts",
    "test:artifact-ai": "vitest run test/artifact-ai.test.ts",
    "test:e05-exit": "vitest run test/e05-exit.test.ts",
    "test:e05-matrix": "npm run build:artifact-proof && playwright test --config proof/artifact/playwright.config.ts hostile-matrix",
    "probe:mapping": "node --env-file=.env ./node_modules/vitest/vitest.mjs run test/mapping-live.test.ts",
    "test:auth:live": "vitest run test/auth-keycloak-live.test.ts",
    "build:web": "tsc -p apps/web/tsconfig.json",
    "build:worker": "tsc -p apps/worker/tsconfig.json",
    "build:parser": "tsc -p proof/import/tsconfig.json",
    "start:worker": "node apps/worker/dist/worker/src/main.js",
    "start:web": "node apps/web/dist/main.js",
    "staging:smoke": "node scripts/staging-smoke.mjs",
    "check": "npm run typecheck && npm test && npm run test:web"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.9.12",
    "bullmq": "6.3.6",
    "fflate": "0.8.3",
    "ioredis": "5.11.1",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@playwright/test": "1.62.0",
    "@types/css-tree": "^3.2.0",
    "@types/node": "22.20.3",
    "@types/pg": "8.23.1",
    "@types/xmldom": "^0.1.34",
    "css-tree": "3.2.1",
    "quickjs-emscripten": "0.32.0",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
