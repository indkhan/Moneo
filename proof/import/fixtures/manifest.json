{
  "proof": "E00-S03 — import fidelity with exact fixtures",
  "note": "Expected amounts/directions/currencies/dates below were specified by hand from the fixture bytes and the declared profiles. They are the independent oracle: the test asserts the parser reproduces them exactly. observationIds are intentionally absent here; the test checks their format and determinism separately.",
  "limits": {
    "maxUploadBytes": 20971520,
    "maxDecompressedBytes": 104857600,
    "maxRows": 100000,
    "maxCols": 50,
    "maxZipEntries": 200,
    "parserDeadlineSeconds": 60,
    "parserProcessBudgetMiB": 256
  },
  "admitted": {
    "encodings": ["UTF-8 with or without BOM"],
    "csvDelimiters": ["comma", "semicolon (declared per import)"],
    "currencies": ["EUR (exponent 2)", "JPY (exponent 0)", "KWD (exponent 3)"],
    "dateFormats": ["iso YYYY-MM-DD", "de DD.MM.YYYY", "us MM/DD/YYYY", "excel-serial day number"],
    "xlsxSubset": "single first worksheet at xl/worksheets/sheet1.xml; plain, shared-string and inline-string cells; no formulas in consumed columns; no external links"
  },
  "excluded": [
    { "shape": "non-UTF-8 encodings (e.g. Latin-1)", "reason": "unsupported-encoding: bytes are rejected rather than transcoded by guess" },
    { "shape": "currencies outside EUR/JPY/KWD", "reason": "unsupported-currency: exponent table is proof-scoped; rows stay reviewable, never converted by guess" },
    { "shape": "amounts with spaces, currency symbols, parentheses or undeclared separators", "reason": "ambiguous-amount: never normalised silently" },
    { "shape": "fraction digits beyond the currency exponent", "reason": "sub-minor-precision: never rounded silently" },
    { "shape": "unrecognised or impossible dates", "reason": "ambiguous-date / invalid-date: century and month/day order are never guessed" },
    { "shape": "formula cells in consumed columns", "reason": "formula-cell: cached values are discarded, row stays reviewable; formulas are never evaluated" },
    { "shape": "workbooks with external links", "reason": "external-link: whole file rejected, links never fetched" },
    { "shape": "multi-sheet workbooks beyond the first sheet", "reason": "first sheet consumed, remainder reported as ignoredSheets; richer workbook UX is later product work" },
    { "shape": "tab-delimited or headerless files", "reason": "unsupported-schema: delimiter and mapping are declared, never sniffed" }
  ],
