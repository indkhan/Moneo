# --- App ---
APP_ENV=development
APP_RELEASE=dev
GIT_SHA=local
PORT=3000

# --- Postgres (local docker compose) ---
DATABASE_URL=postgres://moneo:moneo@localhost:5432/moneo
# Direct URL used ONLY by the release-time migration runner. Never used by app boot.
DATABASE_MIGRATION_URL=postgres://moneo:moneo@localhost:5432/moneo

# --- Redis / BullMQ ---
REDIS_URL=redis://localhost:6379

# --- S3-compatible object storage (local MinIO) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=eu-west-1
S3_BUCKET=moneo-quarantine
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio123

# --- Observability ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=moneo
LOG_LEVEL=info
