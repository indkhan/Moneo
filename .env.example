# E01-S01 environment template: variable NAMES only. Copy to .env (ignored by
# Git) and fill in machine-local synthetic values for development. Never
# commit real values; never print them in logs, docs or prompts.
#
#   Copy-Item .env.example .env   # PowerShell
#   cp .env.example .env          # bash
#
# Application slice (S01)
APP_ENV=development
APP_RELEASE=dev
GIT_SHA=unknown
PORT=3000
APP_BASE_URL=http://localhost:3000

# Identity (S02 consumes; Keycloak self-hosted per 2026-09-17 founder decision)
KEYCLOAK_ISSUER=
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=
SESSION_SECRET=

# Data (S03 consumes; disposable local PostgreSQL, app role + migration role)
DATABASE_URL=
DATABASE_MIGRATION_URL=

# Jobs (E02 consumes; disposable local Redis, loopback only)
REDIS_URL=
