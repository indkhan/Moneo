# ── Copy this to .env and fill in your keys ──
# copy .env.example .env   (PowerShell: copy .env.example .env)

# ── Supabase (Database / Auth / Storage) ──
# Find in: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Postgres connection string for Drizzle (Supabase → Settings → Database → Connection string)
# Use the pooled (port 6543) URL for serverless/Vercel.
DATABASE_URL=

# ── AI — OpenRouter (free models only, verified 2026-09-26) ──
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Default free model (verified live on 2026-09-26 via openrouter.ai/api/v1/models):
OPENROUTER_MODEL=qwen/qwen3.8-27b:free
# Other working :free ids right now:
#   google/gemma-4-26b-a4b-it:free
#   nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
#   nvidia/nemotron-3-ultra-550b-a55b:free
#   thinkingmachines/inkling:free
#   cohere/north-mini-code:free

# ── App ──
NEXT_PUBLIC_APP_URL=http://localhost:3000
