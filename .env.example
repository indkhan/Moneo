# ── Moneo configuration ──
# npm run setup creates .env from this file and fills in the backend secrets.

# ── Self-hosted backend (filled in by `npm run setup`; leave empty) ──
# Postgres + Supabase Auth/PostgREST/Storage run in Docker on 127.0.0.1 (docker-compose.yml).
POSTGRES_PASSWORD=
# Signs the API keys below; changing it needs a fresh database.
JWT_SECRET=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only (never prefix with NEXT_PUBLIC_).
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=
# The single owner Moneo signs in automatically; there is no sign-in screen.
MONEO_OWNER_EMAIL=
MONEO_OWNER_PASSWORD=
# Optional: other local ports if 54321/54322 are taken (rerun setup after changing).
# API_PORT=54321
# DB_PORT=54322

# ── AI ──
# Either sign in with your ChatGPT plan (Settings → AI access) or set an OpenAI API key;
# both work, and Settings picks which one pays. Voice calls and dictation need the API key.
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Optional: OpenRouter key (https://openrouter.ai/keys) for vendor/model IDs.
OPENROUTER_API_KEY=
# Each agent's model is typed per workspace in Settings → AI and your data;
# plain IDs (gpt-6.1-sol) use OpenAI, vendor/model IDs use OpenRouter.

# ── App ──
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional local Workflow transport override if its server uses another port.
# WORKFLOW_LOCAL_BASE_URL=http://localhost:3000

# Server-only bearer secret for daily summary and review recovery crons; set in production too.
CRON_SECRET=
# Also authorizes the bank sync cron (/api/cron/bank-sync).

# ── Bank sync — Enable Banking (optional; see README "Connect your bank") ──
# Application ID from the Enable Banking control panel (also the JWT key id).
ENABLE_BANKING_APP_ID=
# The application's RSA private key (PEM). One line with literal \n is fine:
# ENABLE_BANKING_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----"
ENABLE_BANKING_PRIVATE_KEY=
# API base URL; the default is production.
ENABLE_BANKING_API_URL=https://api.enablebanking.com
# 32 random bytes, base64. Encrypts bank session ids at rest. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Changing it makes existing connections unreadable: disconnect and reconnect them.
BANK_TOKEN_ENCRYPTION_KEY=

# Persistent QA login for authenticated Playwright specs (written by scripts/e2e-auth.mjs)
E2E_USER_EMAIL=
E2E_USER_PASSWORD=
