# --- App ---
APP_ENV=development
APP_RELEASE=dev
GIT_SHA=local
PORT=3000
APP_BASE_URL=http://localhost:3000

# --- Auth0 EU tenant (Epoch 1, Issue 1.3). Tokens never leave the server. ---
AUTH0_DOMAIN=<tenant>.eu.auth0.com
AUTH0_CLIENT_ID=<regular-web-application-client-id>
AUTH0_CLIENT_SECRET=<regular-web-application-client-secret>
# Generate with: openssl rand -hex 32 (64 hex characters).
# Required by the official Auth0 Next.js SDK; it encrypts the session cookie.
AUTH0_SECRET=<64-hex-character-random-value>
# Optional branding hostname; the canonical EU domain stays the token issuer.
AUTH0_CUSTOM_DOMAIN=
# Dedicated Machine-to-Machine app, authorized only for MFA method reads and enrollment tickets.
AUTH0_MANAGEMENT_CLIENT_ID=<m2m-client-id>
AUTH0_MANAGEMENT_CLIENT_SECRET=<m2m-client-secret>
# Set false to disable offering passkey enrollment; defaults to enabled when empty.
AUTH0_PASSKEYS_ENABLED=true
# 64 hex characters; fallback secret for transaction-search cursors.
SESSION_SECRET=<64-hex-character-random-value>
# Optional dedicated cursor-signing secret; SESSION_SECRET is used when this is empty.
SEARCH_CURSOR_SECRET=

# --- Postgres (local docker compose) ---
DATABASE_URL=postgres://moneo_app:<app-password>@localhost:5432/moneo
# Direct URL used ONLY by the release-time migration runner. Never used by app boot.
DATABASE_MIGRATION_URL=postgres://moneo:moneo@localhost:5432/moneo
# Dedicated login granted only the moneo_dispatcher capability role. Required by the worker.
OUTBOX_DATABASE_URL=postgres://moneo_dispatcher:<dispatcher-password>@localhost:5432/moneo

# --- Redis / BullMQ ---
REDIS_URL=redis://localhost:6379

# --- S3-compatible object storage (local MinIO) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=eu-west-1
S3_BUCKET=moneo-quarantine
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio123

# --- Observability ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=moneo
LOG_LEVEL=info

# --- AI provider (reserved for the Epoch 6 assistant) ---
OPENROUTER_API_KEY=
# Local development only. Generate with: openssl rand -base64 32
# Production uses a KMS adapter and refuses this software wrapper.
AI_CREDENTIAL_ENCRYPTION_KEY=
# Required in staging/production. Convention: alias/finance-{environment}-user-credentials.
# AWS SDK authentication uses its default credential provider chain.
AI_CREDENTIAL_KMS_KEY_ID=

# --- Browser end-to-end tests ---
PLAYWRIGHT_BASE_URL=http://localhost:3000
