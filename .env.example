# ── Copy this to .env and fill in your keys ──
# copy .env.example .env   (PowerShell: copy .env.example .env)

# ── Supabase (Database / Auth / Storage — PostgREST, no connection string needed) ──
# Find in: Supabase Dashboard → Project Settings → API
# ("Publishable" key — Supabase's current name for the public anon key)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only key for durable import workflows (never prefix with NEXT_PUBLIC_).
SUPABASE_SERVICE_ROLE_KEY=
# Optional local migration connection string (never expose to the browser).
SUPABASE_DB_URL=

# ── AI — OpenRouter ──
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Model defaults to nvidia/nemotron-3.5-lightning:free and is chosen per
# workspace in Settings. Other working :free ids right now:
#   google/gemma-4-26b-a4b-it:free
#   nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
#   nvidia/nemotron-3-ultra-550b-a55b:free
#   thinkingmachines/inkling:free
#   cohere/north-mini-code:free

# ── App ──
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional local Workflow transport override if its server uses another port.
# WORKFLOW_LOCAL_BASE_URL=http://localhost:3000

# Server-only bearer secret for daily summary and review recovery crons; set in production too.
CRON_SECRET=
# Also authorizes the bank sync cron (/api/cron/bank-sync).

# ── Bank sync — Enable Banking (optional; see README "Connect your bank") ──
# Application ID from the Enable Banking control panel (also the JWT key id).
ENABLE_BANKING_APP_ID=
# The application's RSA private key (PEM). One line with literal \n is fine:
# ENABLE_BANKING_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----"
ENABLE_BANKING_PRIVATE_KEY=
# API base URL; the default is production.
ENABLE_BANKING_API_URL=https://api.enablebanking.com
# 32 random bytes, base64. Encrypts bank session ids at rest. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Changing it makes existing connections unreadable: disconnect and reconnect them.
BANK_TOKEN_ENCRYPTION_KEY=
