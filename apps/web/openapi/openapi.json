{
  "openapi": "3.1.0",
  "info": {
    "title": "Moneo API",
    "version": "v1",
    "description": "Moneo v1 API. Money travels as decimal strings (integer minor units, never floats); entity versions travel as decimal strings. Failures use RFC 9457 problem details with a stable machine-readable `code`."
  },
  "servers": [{ "url": "/api/v1" }],
  "paths": {
    "/health": {
      "get": {
        "operationId": "getHealth",
        "summary": "Service health",
        "responses": {
          "200": {
            "description": "Health status",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["status", "service"],
                  "properties": {
                    "status": { "type": "string", "const": "ok" },
                    "service": { "type": "string", "const": "web" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/version": {
      "get": {
        "operationId": "getVersion",
        "summary": "Release version",
        "responses": {
          "200": {
            "description": "Release coordinates",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["gitSha", "releaseId", "schemaVersion", "environment"],
                  "properties": {
                    "gitSha": { "type": "string" },
                    "releaseId": { "type": "string" },
                    "schemaVersion": { "type": "string" },
                    "environment": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/jobs": {
      "get": {
        "operationId": "listJobs",
        "summary": "List durable jobs (cursor page)",
        "parameters": [
          { "$ref": "#/components/parameters/Cursor" },
          { "$ref": "#/components/parameters/PageLimit" }
        ],
        "responses": {
          "200": {
            "description": "A cursor page of jobs",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["items"],
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/JobStatus" }
                    },
                    "nextCursor": { "type": ["string", "null"] }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/ValidationFailed" }
        }
      },
      "post": {
        "operationId": "submitJob",
        "summary": "Submit a durable job",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/JobSubmit" } }
          }
        },
        "responses": {
          "202": {
            "description": "Job accepted",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/JobStatus" } }
            }
          },
          "400": { "$ref": "#/components/responses/ValidationFailed" },
          "409": { "$ref": "#/components/responses/IdempotencyConflict" },
          "429": { "$ref": "#/components/responses/RateLimited" }
        }
      }
    },
    "/jobs/{id}": {
      "get": {
        "operationId": "getJob",
        "summary": "Durable job status",
        "parameters": [{ "$ref": "#/components/parameters/JobId" }],
        "responses": {
          "200": {
            "description": "Job status",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/JobStatus" } }
            }
          },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/jobs/{id}/retry": {
      "post": {
        "operationId": "retryJob",
        "summary": "Retry a failed job with budget left",
        "parameters": [{ "$ref": "#/components/parameters/JobId" }],
        "responses": {
          "202": {
            "description": "Retry accepted",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/JobStatus" } }
            }
          },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "422": { "$ref": "#/components/responses/InvariantViolation" }
        }
      }
    },
    "/jobs/{id}/stop": {
      "post": {
        "operationId": "stopJob",
        "summary": "Request cancellation of a live job",
        "parameters": [{ "$ref": "#/components/parameters/JobId" }],
        "responses": {
          "202": {
            "description": "Stop accepted",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/JobStatus" } }
            }
          },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/Conflict" }
        }
      }
    },
    "/commands/{commandName}": {
      "post": {
        "operationId": "executeCommand",
        "summary": "Run a typed domain command idempotently",
        "parameters": [
          {
            "name": "commandName",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "minLength": 1, "maxLength": 120 }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/CommandRequest" } }
          }
        },
        "responses": {
          "200": {
            "description": "Command result (replayed results return the identical body)",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/CommandResult" } }
            }
          },
          "400": { "$ref": "#/components/responses/ValidationFailed" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "422": { "$ref": "#/components/responses/InvariantViolation" },
          "429": { "$ref": "#/components/responses/RateLimited" }
        }
      }
    },
    "/accounts": {
      "get": {
        "operationId": "listAccounts",
        "summary": "List canonical accounts with their latest known balance",
        "parameters": [
          {
            "name": "includeArchived",
            "in": "query",
            "required": false,
            "schema": { "type": "boolean", "default": false }
          }
        ],
        "responses": {
          "200": {
            "description": "Workspace accounts in stable creation order",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/AccountList" } }
            }
          },
          "400": { "$ref": "#/components/responses/ValidationFailed" }
        }
      }
    },
    "/accounts/{id}": {
      "get": {
        "operationId": "getAccount",
        "summary": "One canonical account with its latest known balance",
        "parameters": [{ "$ref": "#/components/parameters/AccountId" }],
        "responses": {
          "200": {
            "description": "Account detail",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Account" } }
            }
          },
          "400": { "$ref": "#/components/responses/ValidationFailed" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/accounts/{id}/balance-preview": {
      "get": {
        "operationId": "previewBalance",
        "summary": "Project a proposed balance snapshot over later transactions",
        "parameters": [
          { "$ref": "#/components/parameters/AccountId" },
          {
            "name": "currentAmountMinor",
            "in": "query",
            "required": true,
            "schema": { "$ref": "#/components/schemas/MoneyString" }
          },
          {
            "name": "currencyCode",
            "in": "query",
            "required": true,
            "schema": { "type": "string", "pattern": "^[A-Za-z]{3}$" }
          },
          {
            "name": "cutoffDate",
            "in": "query",
            "required": false,
            "schema": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" }
          }
        ],
        "responses": {
          "200": {
            "description": "Projection or honest unresolved reason; never a mutation",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/BalancePreview" } }
            }
          },
          "400": { "$ref": "#/components/responses/ValidationFailed" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/transactions/{id}": {
      "get": {
        "operationId": "getTransaction",
        "summary": "One canonical transaction with source provenance",
        "parameters": [{ "$ref": "#/components/parameters/TransactionId" }],
        "responses": {
          "200": {
            "description": "Transaction detail with original source observations",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/TransactionDetail" } }
            }
          },
          "400": { "$ref": "#/components/responses/ValidationFailed" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/matches/pending": {
      "get": {
        "operationId": "listPendingMatches",
        "summary": "Staged review rows for one import",
        "parameters": [
          {
            "name": "importId",
            "in": "query",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "responses": {
          "200": {
            "description": "Pending candidates with both sides for review",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MatchCandidateList" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/ValidationFailed" }
        }
      }
    },
    "/transactions/search": {
      "get": {
        "operationId": "searchTransactions",
        "summary": "Search canonical transactions (keyset cursor page)",
        "parameters": [
          { "$ref": "#/components/parameters/Cursor" },
          { "$ref": "#/components/parameters/PageLimit" },
          {
            "name": "accountIds",
            "in": "query",
            "required": false,
            "description": "Comma-separated account UUIDs",
            "schema": { "type": "string", "maxLength": 4000 }
          },
          {
            "name": "dateFrom",
            "in": "query",
            "required": false,
            "schema": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" }
          },
          {
            "name": "dateTo",
            "in": "query",
            "required": false,
            "schema": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" }
          },
          {
            "name": "directions",
            "in": "query",
            "required": false,
            "description": "Comma-separated credit/debit list",
            "schema": { "type": "string", "maxLength": 64 }
          },
          {
            "name": "amountMin",
            "in": "query",
            "required": false,
            "schema": { "$ref": "#/components/schemas/NonNegativeMinorString" }
          },
          {
            "name": "amountMax",
            "in": "query",
            "required": false,
            "schema": { "$ref": "#/components/schemas/NonNegativeMinorString" }
          },
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "Case-insensitive substring over the description",
            "schema": { "type": "string", "maxLength": 200 }
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "schema": { "type": "string", "enum": ["newest", "oldest"], "default": "newest" }
          }
        ],
        "responses": {
          "200": {
            "description": "A cursor page of canonical transactions",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/TransactionPage" } }
            }
          },
          "400": { "$ref": "#/components/responses/ValidationFailed" }
        }
      }
    },
    "/imports/initiate": {
      "post": {
        "operationId": "initiateUpload",
        "summary": "Validate a statement declaration and reserve a private quarantine key",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/UploadInitiate" } }
          }
        },
        "responses": {
          "200": {
            "description": "Reserved quarantine key (internal, never a public URL)",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/UploadInitiated" } }
            }
          },
          "400": { "$ref": "#/components/responses/ValidationFailed" }
        }
      }
    },
    "/imports/bytes": {
      "post": {
        "operationId": "putImportBytes",
        "summary": "Upload statement bytes to quarantine storage",
        "parameters": [
          {
            "name": "importId",
            "in": "query",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          },
          {
            "name": "fileName",
            "in": "query",
            "required": true,
            "schema": { "type": "string", "minLength": 1, "maxLength": 256 }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/octet-stream": { "schema": { "type": "string", "format": "binary" } }
          }
        },
        "responses": {
          "200": {
            "description": "Stored bytes with size and digest",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["importId", "objectKey", "bytes", "sha256"],
                  "properties": {
                    "importId": { "type": "string", "format": "uuid" },
                    "objectKey": { "type": "string" },
                    "bytes": { "type": "integer", "minimum": 1 },
                    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/ValidationFailed" }
        }
      }
    },
    "/imports/preview": {
      "post": {
        "operationId": "previewImport",
        "summary": "Parse quarantined bytes and detect the column mapping",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ImportPreviewRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Headers, sample rows, and detected mapping",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ImportPreview" } }
            }
          },
          "400": { "$ref": "#/components/responses/ValidationFailed" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/imports/complete": {
      "post": {
        "operationId": "completeUpload",
        "summary": "Verify quarantined bytes and store their metadata",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/UploadComplete" } }
          }
        },
        "responses": {
          "200": {
            "description": "Stored upload metadata",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/UploadCompleted" } }
            }
          },
          "400": { "$ref": "#/components/responses/ValidationFailed" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "AccountId": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": { "type": "string", "format": "uuid" }
      },
      "TransactionId": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": { "type": "string", "format": "uuid" }
      },
      "Cursor": {
        "name": "cursor",
        "in": "query",
        "required": false,
        "schema": { "type": "string", "maxLength": 2048 }
      },
      "PageLimit": {
        "name": "limit",
        "in": "query",
        "required": false,
        "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 25 }
      },
      "JobId": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": { "type": "string", "format": "uuid" }
      }
    },
    "schemas": {
      "MoneyString": {
        "type": "string",
        "pattern": "^-?[0-9]+$",
        "description": "Integer minor units as a decimal string (never a JSON number, never a float)."
      },
      "NonNegativeMinorString": {
        "type": "string",
        "pattern": "^(0|[1-9][0-9]*)$",
        "description": "Non-negative integer minor units as a decimal string (search bounds, never a float)."
      },
      "VersionString": {
        "type": "string",
        "pattern": "^[0-9]+$",
        "description": "Optimistic-concurrency version as a decimal string."
      },
      "ProblemDetails": {
        "type": "object",
        "required": ["type", "title", "status", "detail", "code", "retryable", "correlationId"],
        "properties": {
          "type": { "type": "string", "format": "uri" },
          "title": { "type": "string" },
          "status": { "type": "integer" },
          "detail": { "type": "string" },
          "code": {
            "type": "string",
            "enum": [
              "VALIDATION_FAILED",
              "NOT_FOUND",
              "FORBIDDEN",
              "VERSION_CONFLICT",
              "IDEMPOTENCY_KEY_REUSED",
              "RATE_LIMITED",
              "JOB_REQUIRED",
              "UNKNOWN_OUTCOME",
              "INVARIANT_VIOLATION",
              "DEPENDENCY_UNAVAILABLE",
              "INTERNAL_ERROR"
            ]
          },
          "retryable": { "type": "boolean" },
          "correlationId": { "type": "string" },
          "errors": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["field", "message"],
              "properties": {
                "field": { "type": "string" },
                "message": { "type": "string" }
              }
            }
          },
          "instance": { "type": "string" }
        }
      },
      "CommandMetadata": {
        "type": "object",
        "required": ["idempotencyKey"],
        "properties": {
          "idempotencyKey": { "type": "string", "minLength": 1, "maxLength": 128 },
          "expectedVersion": { "$ref": "#/components/schemas/VersionString" }
        }
      },
      "CommandRequest": {
        "type": "object",
        "required": ["metadata", "input"],
        "properties": {
          "metadata": { "$ref": "#/components/schemas/CommandMetadata" },
          "input": { "type": "object" }
        }
      },
      "CommandResult": {
        "type": "object",
        "required": ["operationId", "replayed", "result"],
        "properties": {
          "operationId": { "type": "string" },
          "replayed": { "type": "boolean" },
          "result": { "type": "object" }
        }
      },
      "JobSubmit": {
        "type": "object",
        "required": ["type"],
        "properties": {
          "type": { "type": "string", "minLength": 1, "maxLength": 120 },
          "payload": { "type": "object" },
          "dedupeKey": { "type": "string", "minLength": 1, "maxLength": 128 }
        }
      },
      "ImportPreviewRequest": {
        "type": "object",
        "required": ["importId", "fileName"],
        "properties": {
          "importId": { "type": "string", "format": "uuid" },
          "fileName": { "type": "string", "minLength": 1, "maxLength": 256 },
          "previewRows": { "type": "integer", "minimum": 1, "maximum": 20 }
        }
      },
      "ImportPreview": {
        "type": "object",
        "required": [
          "importId",
          "dataSourceId",
          "fileName",
          "kind",
          "headers",
          "preview",
          "totalRows",
          "mapping",
          "suggestedAccount"
        ],
        "properties": {
          "importId": { "type": "string", "format": "uuid" },
          "dataSourceId": { "type": "string", "format": "uuid" },
          "duplicate": {
            "type": ["object", "null"],
            "required": ["isRepeat", "message"],
            "properties": {
              "isRepeat": { "type": "boolean", "const": true },
              "message": { "type": "string" }
            }
          },
          "fileName": { "type": "string" },
          "kind": { "type": "string", "enum": ["csv", "xlsx"] },
          "delimiter": { "type": ["string", "null"] },
          "headers": { "type": "array", "items": { "type": "string" } },
          "preview": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["rowNumber", "cells"],
              "properties": {
                "rowNumber": { "type": "integer", "minimum": 1 },
                "cells": { "type": "array", "items": { "type": "string" } }
              }
            }
          },
          "totalRows": { "type": "integer", "minimum": 0 },
          "parseErrors": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["rowNumber", "message"],
              "properties": {
                "rowNumber": { "type": "integer", "minimum": 1 },
                "message": { "type": "string" }
              }
            }
          },
          "mapping": { "type": "object" },
          "confidence": { "type": "object" },
          "unmapped": { "type": "array", "items": { "type": "integer" } },
          "suggestedAccount": { "type": "string" }
        }
      },
      "UploadInitiate": {
        "type": "object",
        "required": ["fileName", "contentLength"],
        "properties": {
          "fileName": { "type": "string", "minLength": 1, "maxLength": 256 },
          "contentLength": { "type": "integer", "minimum": 1, "maximum": 10485760 }
        }
      },
      "UploadInitiated": {
        "type": "object",
        "required": ["importId", "objectKey", "mime", "maxBytes"],
        "properties": {
          "importId": { "type": "string", "format": "uuid" },
          "objectKey": { "type": "string" },
          "mime": { "type": "string" },
          "maxBytes": { "type": "integer", "minimum": 1 }
        }
      },
      "UploadComplete": {
        "type": "object",
        "required": ["importId", "objectKey", "fileName"],
        "properties": {
          "importId": { "type": "string", "format": "uuid" },
          "objectKey": { "type": "string", "minLength": 1, "maxLength": 512 },
          "fileName": { "type": "string", "minLength": 1, "maxLength": 256 },
          "expectedSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      },
      "UploadCompleted": {
        "type": "object",
        "required": ["workspaceId", "importId", "objectKey", "fileName", "mime", "bytes", "sha256"],
        "properties": {
          "workspaceId": { "type": "string", "format": "uuid" },
          "importId": { "type": "string", "format": "uuid" },
          "objectKey": { "type": "string" },
          "fileName": { "type": "string" },
          "mime": { "type": "string" },
          "bytes": { "type": "integer", "minimum": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      },
      "JobStatus": {
        "type": "object",
        "required": ["id", "type", "status", "attempts", "maxAttempts", "createdAt", "updatedAt"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "type": { "type": "string" },
          "status": {
            "type": "string",
            "enum": ["queued", "running", "succeeded", "failed", "cancelled"]
          },
          "progressStage": { "type": ["string", "null"] },
          "progressPercent": { "type": ["integer", "null"], "minimum": 0, "maximum": 100 },
          "attempts": { "type": "integer", "minimum": 0 },
          "maxAttempts": { "type": "integer", "minimum": 1 },
          "error": { "type": ["object", "null"] },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "AccountBalance": {
        "type": "object",
        "required": [
          "currentAmountMinor",
          "availableAmountMinor",
          "currencyCode",
          "observedAt",
          "source"
        ],
        "properties": {
          "currentAmountMinor": {
            "type": ["string", "null"],
            "description": "Decimal-string minor units; null means unknown, never zero."
          },
          "availableAmountMinor": {
            "type": ["string", "null"],
            "description": "Decimal-string minor units; null means unknown, never zero."
          },
          "currencyCode": { "type": "string" },
          "observedAt": { "type": "string", "format": "date-time" },
          "source": { "type": "string" }
        }
      },
      "Account": {
        "type": "object",
        "required": [
          "id",
          "name",
          "accountType",
          "currencyCode",
          "isSpendable",
          "includeInNetWorth",
          "createdAt",
          "updatedAt",
          "balanceState",
          "balance"
        ],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "name": { "type": "string" },
          "institutionName": { "type": ["string", "null"] },
          "accountType": {
            "type": "string",
            "enum": ["CHECKING", "SAVINGS", "CASH", "CREDIT", "INVESTMENT", "WALLET", "OTHER"]
          },
          "currencyCode": { "type": "string" },
          "isSpendable": { "type": "boolean" },
          "includeInNetWorth": { "type": "boolean" },
          "archivedAt": { "type": ["string", "null"], "format": "date-time" },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" },
          "balanceState": {
            "type": "string",
            "enum": ["unknown", "ok", "unreconciled", "conflict"],
            "description": "Coverage state for aggregate gates; unknown/conflict/unreconciled are never zero."
          },
          "balance": {
            "description": "Latest known snapshot; null means the balance is unknown, never zero.",
            "oneOf": [{ "$ref": "#/components/schemas/AccountBalance" }, { "type": "null" }]
          }
        }
      },
      "AccountList": {
        "type": "object",
        "required": ["items"],
        "properties": {
          "items": { "type": "array", "items": { "$ref": "#/components/schemas/Account" } }
        }
      },
      "BalancePreview": {
        "type": "object",
        "required": [
          "applicableCount",
          "skippedCrossCurrency",
          "projectedCurrentMinor",
          "unresolved",
          "reason",
          "truncated"
        ],
        "properties": {
          "applicableCount": { "type": "integer", "minimum": 0 },
          "skippedCrossCurrency": { "type": "integer", "minimum": 0 },
          "projectedCurrentMinor": {
            "type": ["string", "null"],
            "description": "Decimal-string minor units; null when unresolved."
          },
          "unresolved": { "type": "boolean" },
          "reason": {
            "type": ["string", "null"],
            "enum": ["no-cutoff", "no-snapshot-amount", "mixed-currency", "truncated", null]
          },
          "truncated": { "type": "boolean" }
        }
      },
      "Transaction": {
        "type": "object",
        "required": [
          "id",
          "accountId",
          "status",
          "direction",
          "amountMinor",
          "currencyCode",
          "effectiveDate",
          "description",
          "excludedFromAnalytics",
          "createdAt",
          "updatedAt"
        ],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "accountId": { "type": "string", "format": "uuid" },
          "status": { "type": "string", "enum": ["PENDING", "POSTED", "VOIDED"] },
          "direction": { "type": "string", "enum": ["credit", "debit"] },
          "amountMinor": { "$ref": "#/components/schemas/NonNegativeMinorString" },
          "currencyCode": { "type": "string" },
          "effectiveDate": { "type": "string", "format": "date" },
          "description": { "type": "string" },
          "note": { "type": ["string", "null"] },
          "excludedFromAnalytics": { "type": "boolean" },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "TransactionPage": {
        "type": "object",
        "required": ["items"],
        "properties": {
          "items": { "type": "array", "items": { "$ref": "#/components/schemas/Transaction" } },
          "nextCursor": { "type": ["string", "null"] }
        }
      },
      "TransactionSource": {
        "type": "object",
        "required": [
          "sourceTransactionId",
          "relationship",
          "dataSourceId",
          "dataSourceName",
          "observedAt",
          "rawPayload"
        ],
        "properties": {
          "sourceTransactionId": { "type": "string", "format": "uuid" },
          "relationship": {
            "type": "string",
            "enum": ["PRIMARY", "PENDING_PREDECESSOR", "MERGED", "OTHER"]
          },
          "dataSourceId": { "type": "string", "format": "uuid" },
          "dataSourceName": { "type": "string" },
          "importId": { "type": ["string", "null"], "format": "uuid" },
          "fileName": { "type": ["string", "null"] },
          "observedAt": { "type": "string", "format": "date-time" },
          "rawPayload": { "type": "object" }
        }
      },
      "TransactionDetail": {
        "type": "object",
        "required": ["accountName", "sources"],
        "allOf": [
          { "$ref": "#/components/schemas/Transaction" },
          {
            "type": "object",
            "properties": {
              "accountName": { "type": "string" },
              "sources": {
                "type": "array",
                "items": { "$ref": "#/components/schemas/TransactionSource" }
              }
            }
          }
        ]
      },
      "MatchCandidate": {
        "type": "object",
        "required": [
          "id",
          "importId",
          "sourceTransactionId",
          "candidateTransactionId",
          "matchRule",
          "candidateDescription",
          "stagedDescription",
          "createdAt"
        ],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "importId": { "type": "string", "format": "uuid" },
          "sourceTransactionId": { "type": "string", "format": "uuid" },
          "candidateTransactionId": { "type": "string", "format": "uuid" },
          "matchRule": {
            "type": "string",
            "enum": ["trusted-external-id", "fuzzy-date-amount-description"]
          },
          "candidateDate": { "type": "string" },
          "candidateDescription": { "type": "string" },
          "candidateAmountMinor": { "type": "string" },
          "candidateCurrency": { "type": "string" },
          "stagedDescription": { "type": "string" },
          "stagedDate": { "type": "string" },
          "stagedAmountMinor": { "type": "string" },
          "stagedCurrency": { "type": "string" },
          "stagedDirection": { "type": "string", "enum": ["credit", "debit"] },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      },
      "MatchCandidateList": {
        "type": "object",
        "required": ["items"],
        "properties": {
          "items": { "type": "array", "items": { "$ref": "#/components/schemas/MatchCandidate" } }
        }
      }
    },
    "responses": {
      "ValidationFailed": {
        "description": "Malformed request (see `errors` for fields)",
        "content": {
          "application/problem+json": {
            "schema": { "$ref": "#/components/schemas/ProblemDetails" }
          }
        }
      },
      "NotFound": {
        "description": "Unknown job, command, or entity",
        "content": {
          "application/problem+json": {
            "schema": { "$ref": "#/components/schemas/ProblemDetails" }
          }
        }
      },
      "Forbidden": {
        "description": "Caller may not perform this action",
        "content": {
          "application/problem+json": {
            "schema": { "$ref": "#/components/schemas/ProblemDetails" }
          }
        }
      },
      "Conflict": {
        "description": "Version conflict or idempotency-key reuse",
        "content": {
          "application/problem+json": {
            "schema": { "$ref": "#/components/schemas/ProblemDetails" }
          }
        }
      },
      "IdempotencyConflict": {
        "description": "Same dedupe key submitted with a different payload",
        "content": {
          "application/problem+json": {
            "schema": { "$ref": "#/components/schemas/ProblemDetails" }
          }
        }
      },
      "InvariantViolation": {
        "description": "Input is well-formed but violates a domain invariant",
        "content": {
          "application/problem+json": {
            "schema": { "$ref": "#/components/schemas/ProblemDetails" }
          }
        }
      },
      "RateLimited": {
        "description": "Too many requests (honour `Retry-After`)",
        "content": {
          "application/problem+json": {
            "schema": { "$ref": "#/components/schemas/ProblemDetails" }
          }
        }
      }
    }
  }
}
