{
  "name": "@moneo/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "drizzle"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "default": "./dist/schema.js"
    },
    "./currencies": {
      "types": "./dist/currencies.d.ts",
      "default": "./dist/currencies.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./provisioning": {
      "types": "./dist/provisioning.d.ts",
      "default": "./dist/provisioning.js"
    },
    "./tenancy": {
      "types": "./dist/tenancy.d.ts",
      "default": "./dist/tenancy.js"
    },
    "./uuid": {
      "types": "./dist/uuid.d.ts",
      "default": "./dist/uuid.js"
    },
    "./workspaces": {
      "types": "./dist/workspaces.d.ts",
      "default": "./dist/workspaces.js"
    },
    "./job-queue": {
      "types": "./dist/job-queue.d.ts",
      "default": "./dist/job-queue.js"
    },
    "./statement-imports": {
      "types": "./dist/statement-imports.d.ts",
      "default": "./dist/statement-imports.js"
    },
    "./account-queries": {
      "types": "./dist/account-queries.d.ts",
      "default": "./dist/account-queries.js"
    },
    "./transaction-queries": {
      "types": "./dist/transaction-queries.d.ts",
      "default": "./dist/transaction-queries.js"
    },
    "./transaction-detail": {
      "types": "./dist/transaction-detail.d.ts",
      "default": "./dist/transaction-detail.js"
    },
    "./sessions": {
      "types": "./dist/sessions.d.ts",
      "default": "./dist/sessions.js"
    },
    "./version": {
      "types": "./dist/version.d.ts",
      "default": "./dist/version.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "generate": "drizzle-kit generate",
    "migrate": "tsx ./src/migrate.ts",
    "seed": "tsx ./src/seed.ts"
  },
  "dependencies": {
    "@moneo/finance": "workspace:*",
    "@moneo/shared": "workspace:*",
    "drizzle-orm": "^0.45.0",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "^22.7.4",
    "@types/pg": "^8.11.0",
    "drizzle-kit": "^0.31.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.3",
    "vitest": "^3.0.0"
  }
}
